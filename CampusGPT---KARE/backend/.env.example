# Campus-GPT Backend Environment Variables
# Copy to .env and fill in values

# Gemini API (Required for chat, embeddings, RAG)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Chat model (gemini-1.5-flash is retired on many keys)
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Database — set PostgreSQL/Supabase for shared DB (otherwise SQLite file is used in dev)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/campus_gpt
# Personal academic data always comes from UIS DB via API (local SIS fallback off)
# ALLOW_LOCAL_SIS_FALLBACK=false


# Vector Store (Gemini embeddings = 768 dimensions)
FAISS_INDEX_PATH=./data/faiss_index
EMBEDDING_DIM=768

# RAG
RAG_TOP_K=5
RAG_CHUNK_SIZE=750
RAG_CHUNK_OVERLAP=100

# Confidence & Escalation
CONFIDENCE_THRESHOLD=0.7
ESCALATION_ENABLED=true

# JWT (Change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ports (Campus-GPT — keep separate from UIS :3000/:8000)
API_BASE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3001
UIS_API_BASE_URL=http://localhost:8000

# Google Sign-In (OAuth Web client). Redirect URI must be exactly:
#   {API_BASE_URL}/api/auth/google/callback
# Only emails ending with @{GOOGLE_ALLOWED_DOMAIN} are accepted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=klu.ac.in

# Supabase Storage (used for document archival; Storage-scoped API key)
# Paste your Supabase project URL e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Paste your Supabase Storage-scoped API key (sb_secret_...)
SUPABASE_KEY=
# Storage bucket for uploaded knowledge-base documents
SUPABASE_BUCKET=campus-documents
# Optional Postgres URL used by Admin → Connections to test Supabase
# SUPABASE_DB_URL=postgresql://postgres:password@db.host:5432/postgres

# Optional MongoDB (Admin → Connections)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=campus

# Optional S3 or S3-compatible storage (Admin → Connections)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# ACTIVE_DATA_STORE=supabase

# Voice: ElevenLabs (STT via Scribe + TTS). Preferred — no ffmpeg needed for mic input.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_ENABLED=true
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_STT_MODEL=scribe_v2

# Optional Whisper fallback (needs ffmpeg + pydub if ElevenLabs is off)
# WHISPER_MODEL=bryandts/whisper-base-en-india-accent-svarah

# edge-tts fallback voices when ElevenLabs TTS is unavailable
# TTS_VOICE=en-IN-NeerjaNeural

# Email (Gmail SMTP — use an App Password, not your Google login password)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=99230041300@klu.ac.in
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Campus-GPT <99230041300@klu.ac.in>
